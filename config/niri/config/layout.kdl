layout {
    gaps 4
    background-color "transparent"
    border {
        off
    }
    focus-ring {
        off
        width 1
        active-color "#ffffff"
        inactive-color "#00000000"
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
